{
    "id": null,
    "uid": "order-service",
    "title": "Order Service Metrics",
    "tags": [
        "order_service",
        "prometheus"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 5,
    "refresh": "10s",
    "panels": [
        {
            "type": "row",
            "title": "HTTP Requests (Grouped)",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            }
        },
        {
            "id": 1,
            "type": "timeseries",
            "title": "RPS by Endpoint",
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 1
            },
            "targets": [
                {
                    "expr": "sum(rate(http_requests_total{service=\"order_service\", path=\"/api/v0/orders\"}[$__rate_interval])) by (method)",
                    "legendFormat": "List {{method}}",
                    "refId": "A"
                },
                {
                    "expr": "sum(rate(http_requests_total{service=\"order_service\", path=~\"/api/v0/orders/[0-9a-f-]{36}$\"}[$__rate_interval])) by (method)",
                    "legendFormat": "GetOrder {{method}}",
                    "refId": "B"
                },
                {
                    "expr": "sum(rate(http_requests_total{service=\"order_service\", path=~\"/api/v0/orders/[0-9a-f-]+/status\"}[$__rate_interval])) by (method)",
                    "legendFormat": "Cancel {{method}}",
                    "refId": "C"
                },
                {
                    "expr": "sum(rate(http_requests_total{service=\"order_service\", path=\"/api/v0/payments\"}[$__rate_interval])) by (method)",
                    "legendFormat": "CreatePayment {{method}}",
                    "refId": "D"
                },
                {
                    "expr": "sum(rate(http_requests_total{service=\"order_service\", path=~\"/api/v0/payments/order/[0-9a-f-]+\"}[$__rate_interval])) by (method)",
                    "legendFormat": "GetPayment {{method}}",
                    "refId": "E"
                },
                {
                    "expr": "sum(rate(http_requests_total{service=\"order_service\", path=\"/api/v0/payments/webhook\"}[$__rate_interval])) by (method)",
                    "legendFormat": "Webhook {{method}}",
                    "refId": "F"
                },
                {
                    "expr": "sum(rate(http_requests_total{service=\"order_service\", path=\"/api/v0/fake-payment\"}[$__rate_interval])) by (method)",
                    "legendFormat": "FakePayment {{method}}",
                    "refId": "G"
                }
            ]
        },
        {
            "id": 2,
            "type": "timeseries",
            "title": "HTTP Errors (%)",
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 1
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "min": 0,
                    "max": 1
                }
            },
            "targets": [
                {
                    "expr": "sum(rate(http_requests_total{service=\"order_service\", status=~\"4..|5..\"}[$__rate_interval])) / sum(rate(http_requests_total{service=\"order_service\"}[$__rate_interval]))",
                    "legendFormat": "Errors",
                    "refId": "A"
                }
            ]
        },
        {
            "type": "row",
            "title": "Order Business Metrics",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 9
            }
        },
        {
            "id": 4,
            "type": "timeseries",
            "title": "Orders Created/Canceled by Store",
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 10
            },
            "targets": [
                {
                    "expr": "sum(rate(order_service_orders_created_total[$__rate_interval])) by (store_id)",
                    "legendFormat": "Created {{store_id}}",
                    "refId": "A"
                },
                {
                    "expr": "sum(rate(order_service_orders_canceled_total[$__rate_interval])) by (store_id)",
                    "legendFormat": "Canceled {{store_id}}",
                    "refId": "B"
                }
            ]
        },
        {
            "type": "row",
            "title": "GetOrder Performance",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 18
            }
        },
        {
            "id": 11,
            "type": "timeseries",
            "title": "GetOrder RPS by Stores Count",
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 19
            },
            "targets": [
                {
                    "expr": "sum(rate(order_service_orders_get_total[$__rate_interval])) by (stores_count)",
                    "legendFormat": "{{stores_count}} stores",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 12,
            "type": "timeseries",
            "title": "GetOrder P95 Latency by Stores Count",
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 19
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0
                }
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(order_get_duration_seconds_bucket[$__rate_interval])) by (le, stores_count))",
                    "legendFormat": "P95 {{stores_count}} stores",
                    "refId": "A"
                }
            ]
        },
        {
            "type": "row",
            "title": "Payments",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 27
            }
        },
        {
            "id": 7,
            "type": "timeseries",
            "title": "Payments Created by Status",
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 28
            },
            "targets": [
                {
                    "expr": "sum(rate(payments_created_total[$__rate_interval])) by (status)",
                    "legendFormat": "{{status}}",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 8,
            "type": "timeseries",
            "title": "Payments Succeeded/Failed",
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 28
            },
            "targets": [
                {
                    "expr": "rate(payments_succeeded_total[$__rate_interval])",
                    "legendFormat": "Succeeded",
                    "refId": "A"
                },
                {
                    "expr": "sum(rate(payments_failed_total[$__rate_interval])) by (status)",
                    "legendFormat": "Failed {{status}}",
                    "refId": "B"
                }
            ]
        },
        {
            "id": 10,
            "type": "timeseries",
            "title": "Order → Payment Conversion (%)",
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 36
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "min": 0,
                    "max": 1
                }
            },
            "targets": [
                {
                    "expr": "rate(payments_succeeded_total[5m]) / sum(rate(order_service_orders_created_total[5m]))",
                    "legendFormat": "Conversion",
                    "refId": "A"
                }
            ]
        },
        {
            "type": "row",
            "title": "Runtime & Database",
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 44
            }
        },
        {
            "id": 20,
            "type": "timeseries",
            "title": "Go Runtime",
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 45
            },
            "targets": [
                {
                    "expr": "go_goroutines{service=\"order_service\"}",
                    "legendFormat": "Goroutines",
                    "refId": "A"
                },
                {
                    "expr": "go_memstats_alloc_bytes{service=\"order_service\"}",
                    "legendFormat": "Memory Alloc",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                },
                "overrides": [
                    {
                        "matcher": {
                            "id": "byRegexp",
                            "options": {
                                "expr": "Goroutines",
                                "flag": "i"
                            }
                        },
                        "properties": [
                            {
                                "id": "unit",
                                "value": "none"
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": 30,
            "type": "timeseries",
            "title": "Postgres Query P95",
            "datasource": {
                "type": "prometheus",
                "uid": "Prometheus"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 45
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0
                }
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(pg_query_duration_seconds_bucket{job=~\"order-service.*\"}[$__rate_interval])) by (le))",
                    "legendFormat": "P95",
                    "refId": "A"
                }
            ]
        }
    ],
    "templating": {
        "list": [
            {
                "name": "service",
                "type": "query",
                "datasource": {
                    "type": "prometheus",
                    "uid": "Prometheus"
                },
                "query": "label_values(http_requests_total, service)",
                "includeAll": true,
                "multi": true,
                "current": {
                    "selected": false,
                    "text": "All",
                    "value": "$__all"
                }
            },
            {
                "name": "store_id",
                "type": "query",
                "datasource": {
                    "type": "prometheus",
                    "uid": "Prometheus"
                },
                "query": "label_values(order_service_orders_created_total, store_id)",
                "includeAll": true,
                "multi": true,
                "current": {
                    "selected": false,
                    "text": "All",
                    "value": "$__all"
                }
            },
            {
                "name": "stores_count",
                "type": "query",
                "datasource": {
                    "type": "prometheus",
                    "uid": "Prometheus"
                },
                "query": "label_values(order_service_orders_get_total, stores_count)",
                "includeAll": true,
                "multi": true,
                "current": {
                    "selected": false,
                    "text": "All",
                    "value": "$__all"
                }
            }
        ]
    },
    "time": {
        "from": "now-1h",
        "to": "now"
    }
}