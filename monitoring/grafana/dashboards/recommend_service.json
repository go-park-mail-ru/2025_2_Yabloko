{
    "id": null,
    "uid": "recommendation-service",
    "title": "Recommendation Service",
    "tags": [
        "recommendation",
        "service"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "5s",
    "panels": [
        {
            "id": 1,
            "type": "stat",
            "title": "Req/s /recommend/home",
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 8,
                "h": 4
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum(rate(http_requests_total{service=\"recommendation_service\", path=\"/api/v0/recommend/home\"}[$__rate_interval]))",
                    "legendFormat": "req/s",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Error rate /recommend/home",
            "gridPos": {
                "x": 8,
                "y": 0,
                "w": 8,
                "h": 4
            },
            "datasource": "Prometheus",
            "targets": [
                {
                    "expr": "sum(rate(http_requests_total{service=\"recommendation_service\", path=\"/api/v0/recommend/home\", status!=\"OK\"}[$__rate_interval]))",
                    "legendFormat": "errors/s",
                    "refId": "A"
                }
            ]
        },
        {
            "id": 3,
            "type": "graph",
            "title": "Latency /recommend/home p95",
            "gridPos": {
                "x": 0,
                "y": 4,
                "w": 16,
                "h": 7
            },
            "datasource": "Prometheus",
            "lines": true,
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"recommendation_service\", path=\"/api/v0/recommend/home\"}[$__rate_interval])) by (le))",
                    "legendFormat": "p95",
                    "refId": "A"
                }
            ],
            "yaxes": [
                {
                    "format": "s",
                    "logBase": 1
                },
                {
                    "format": "short",
                    "logBase": 1
                }
            ]
        },
        {
            "id": 4,
            "type": "graph",
            "title": "Recommendations by mode",
            "gridPos": {
                "x": 0,
                "y": 11,
                "w": 16,
                "h": 7
            },
            "datasource": "Prometheus",
            "lines": true,
            "stack": false,
            "targets": [
                {
                    "expr": "sum(rate(recommendation_service_home_total{mode=\"profile\"}[$__rate_interval]))",
                    "legendFormat": "profile",
                    "refId": "A"
                },
                {
                    "expr": "sum(rate(recommendation_service_home_total{mode=\"random\"}[$__rate_interval]))",
                    "legendFormat": "random",
                    "refId": "B"
                },
                {
                    "expr": "sum(rate(recommendation_service_home_total{mode=\"empty\"}[$__rate_interval]))",
                    "legendFormat": "empty",
                    "refId": "C"
                }
            ],
            "yaxes": [
                {
                    "format": "req/s",
                    "logBase": 1
                },
                {
                    "format": "short",
                    "logBase": 1
                }
            ]
        },
        {
            "id": 5,
            "type": "graph",
            "title": "Recommendation handler latency by mode",
            "gridPos": {
                "x": 0,
                "y": 18,
                "w": 16,
                "h": 7
            },
            "datasource": "Prometheus",
            "lines": true,
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(recommendation_service_home_duration_seconds_bucket{mode=\"profile\"}[$__rate_interval])) by (le))",
                    "legendFormat": "p95 profile",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.95, sum(rate(recommendation_service_home_duration_seconds_bucket{mode=\"random\"}[$__rate_interval])) by (le))",
                    "legendFormat": "p95 random",
                    "refId": "B"
                }
            ],
            "yaxes": [
                {
                    "format": "s",
                    "logBase": 1
                },
                {
                    "format": "short",
                    "logBase": 1
                }
            ]
        }
    ],
    "templating": {
        "list": []
    },
    "annotations": {
        "list": []
    }
}